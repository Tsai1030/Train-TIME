{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/tdx-auth/:path*",
      "destination": "https://tdx.transportdata.tw/:path*"
    },
    {
      "source": "/tdx/:path*",
      "destination": "https://tdx.transportdata.tw/:path*"
    }
  ]
}
